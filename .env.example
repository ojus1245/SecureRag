@"
# ============================================
# Privacy-Aware RAG - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/secure_rag

# JWT (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Encryption (CHANGE THIS!)
ENCRYPTION_KEY=your-32-character-encryption-key

# Features
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_CACHING=false
@"
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws
"@ | Out-File -FilePath frontend\.env.example -Encoding UTF8
@"
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/secure_rag
JWT_SECRET=change-this-in-production
AI_SERVICE_URL=http://localhost:8000
"@ | Out-File -FilePath backend\.env.example -Encoding UTF8